# --- Runtime ---
ENVIRONMENT=development
# clean | experiment — experiment enables stand-mode switches (see FAULT_*)
CRM_MODE=clean
SECRET_KEY=change-me-in-local-dev-use-long-random
COOKIE_SECURE=false
SESSION_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
BASE_URL=http://localhost:9000
APP_VERSION=0.1.0

# --- Database (local: create database "crm" in PostgreSQL 16) ---
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/crm
# SQLite for quick tests without Postgres:
# DATABASE_URL=sqlite:///./crm.db

# --- Auth ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=demo
SEND_DEFAULT_PII=false
LOG_LEVEL=INFO
# file | elasticsearch | null — local ES from SIP\setup_infra.ps1
LOG_SHIPPER=elasticsearch
LOG_FILE_PATH=logs/crm-ecs.jsonl
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=crm-logs

# --- External deps (mocks / faults) ---
TAX_SERVICE_URL=http://127.0.0.1:9010/api/tax-status
NOTES_SERVICE_URL=http://127.0.0.1:9011/api/notes
TAX_TIMEOUT_SECONDS=2.0

# --- Stand switches (only applied when CRM_MODE=experiment) ---
FAULT_IIN_SECOND_WEIGHTS=false
FAULT_NAME_SEARCH_RAW_SQL=false
FAULT_EXPORT_EMPTY_FIELD=false
FAULT_CORRUPT_RECORD=false
FAULT_TAX_TIMEOUT=false
FAULT_NOTES_DOWN=false
FAULT_POOL_EXHAUSTED=false
